# SwiftPM
.build/
.swiftpm/

# 构建产物
dist/
*.dmg

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# 系统
.DS_Store

# 调试日志
/tmp/agentisland.log

# 截图/OCR 验证产物：仅供本地宣传与验证，不上传（屏幕内容可能含个人会话数据）
artifacts/

# 本地工作区：issue/spec 草稿（单人开发，不入库）；验证记录自 R19 起入库
.scratch/

# 发布包（Release 附件已上传 GitHub）
*.zip

# 个人凭据/账号：任何本地凭据文件一律不得入库
.env
.env.*
*.pem
*.p12
*.key
id_rsa
id_ed25519
*credentials*
*secrets*
# 例外：脱敏门禁本身必须入库，否则别人克隆下来没有这道闸。
# 上面 `*secrets*` 会把它连同 baseline 一起挡掉（v0.0.119 首次发版就这么漏的）
!scripts/scan-secrets.sh
!scripts/test-scan-secrets.sh
!scripts/secrets-baseline.txt
!scripts/secrets-history-allow.txt
!docs/agents/triage-labels.md

# Qoder 智能体隔离工作树（工具状态，不入库）
.qoder/

# ===== 多平台端(Tauri / WPF)构建产物 =====
app/src-tauri/target/
app/src-tauri/gen/schemas/
# vendor 下的独立 crate（tiny_http）单独跑测试时会生成自己的 target 与 lock：
# 不进库，且**必须在扫描口径外**。实测它们留在工作区会让脱敏扫描的 grep
# 以退出码 2 失败，整条 workspace 扫描红——而那不是泄漏，是扫描器读不了二进制。
vendor/*/target/
vendor/*/Cargo.lock
windows/AgentIsland.Wpf/bin/
windows/AgentIsland.Wpf/obj/
windows/.vs/

# Python test-script bytecode
__pycache__/

# Node 依赖：发布门禁里的浏览器 UI 回归需要 Playwright，但它装在项目根，
# 而它自带示例邮箱/密码字面量会被脱敏扫描当成新命中（v0.0.323 发布就这么被拦下）。
# 依赖不进库，也绝不让第三方包的文字进入脱敏口径。
node_modules/
