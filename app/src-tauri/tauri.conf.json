{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentIsland",
  "version": "0.1.0",
  "identifier": "dev.agentisland.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "island",
        "title": "AgentIsland",
        "width": 372,
        "height": 520,
        "x": null,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": true,
        "focus": false,
        "url": "index.html?shell=island"
      },
      {
        "label": "sidebar",
        "title": "AgentIsland",
        "width": 360,
        "height": 800,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "url": "index.html?shell=sidebar"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "AgentIsland"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
